.tab-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1000;
  display: flex;
  height: calc(108rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  border-top: 1rpx solid rgba(120, 94, 88, 0.08);
  background: #fffcf8;
  box-sizing: border-box;
}

.tab-bar__item {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  flex-direction: column;
}

.tab-bar__icon {
  display: block;
  width: 48rpx;
  height: 48rpx;
  flex: none;
}

.tab-bar__text {
  margin-top: 3rpx;
  font-size: 20rpx;
  line-height: 26rpx;
}
